# Supabase Configuration (Backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Client Configuration (Frontend - loaded via vite.config.ts)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Connection (Postgres Direct connection string for pgvector)
DATABASE_URL=postgresql://postgres:[password]@db.[your-project-id].supabase.co:5432/postgres

# LLM Providers Configuration
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Maximum characters of OCR text sent to Groq for biomarker extraction.
# 8000 chars covers ~5-6 pages of lab report text. Increase if biomarkers are
# being missed on longer multi-page reports (at the cost of higher token usage).
MAX_GROQ_INPUT_CHARS=8000

# Local Tesseract OCR Settings (Adjust for your Windows install location)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler binary path for pdf2image (scanned PDF rasterisation).
# Windows: set to the bin/ subfolder of your Poppler installation.
#   Download from: https://github.com/oschwartz10612/poppler-windows/releases
# Linux / Docker: leave blank (poppler-utils found via PATH automatically).
POPPLER_PATH=

# Per-page OCR timeout in seconds. Pages exceeding this limit are skipped
# with a warning rather than hanging the entire analysis pipeline.
OCR_PAGE_TIMEOUT=30
